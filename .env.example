# Copy to .env and fill in. Never commit .env.
# MAX hub mode (starts when MAX_BOT_TOKEN is set)
MAX_BOT_TOKEN=
MAX_BOT_NAME=ideya_fiks_2_bot
GRAPHY_PUBLIC_URL=https://your-host.example:8443
# one-time code to claim the admin role via /claim <code> in the bot
MAX_ADMIN_CLAIM=
# LLM provider key kept on the server (users never see it)
GRAPHY_LLM_KEY=
GRAPHY_LLM_UPSTREAM=https://openrouter.ai/api/v1
# optional
SEARXNG_URL=
GRAPHY_STT_URL=
GRAPHY_MAX_AGENTS=3
GRAPHY_DAILY_LLM_REQUESTS=
# LLM guard (all optional, generous defaults): total per day for signed-in users, per user and per IP per minute
GRAPHY_DAILY_LLM_TOTAL=6000
GRAPHY_LLM_PER_MIN=40
GRAPHY_LLM_IP_PER_MIN=120
# admin alert in MAX when someone makes this many requests within the window
GRAPHY_ACTIVE_ALERT_REQUESTS=100
GRAPHY_ACTIVE_ALERT_MINUTES=15
# thresholds of the suspicious-activity alerts to admins (defaults shown)
GRAPHY_SUSPICIOUS_AUTH_FAILS=10
GRAPHY_SUSPICIOUS_ANON_TOKENS=8
GRAPHY_SUSPICIOUS_LIMIT_HITS=5
GRAPHY_SUSPICIOUS_BLOCKED_HITS=5
GRAPHY_SUSPICIOUS_CLAIM_FAILS=3
# write the text of learners' messages into llm.log (switch later with /prompts on|off in the bot)
GRAPHY_LOG_PROMPTS=0
# new users (registered after the first start of this version) get this many requests a day; /setlimit new <n> changes it
GRAPHY_NEW_USER_DAILY=40
# agent -> admin reports per user per hour, and automatic block after N high-severity reports in an hour (0 = never)
GRAPHY_REPORTS_PER_HOUR=6
GRAPHY_AUTO_BLOCK_HIGH=0
